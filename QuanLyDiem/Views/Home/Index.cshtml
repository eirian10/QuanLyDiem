@{
    ViewData["Title"] = "Trang chủ";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="home-container">
    <div class="hero-section mb-4">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Chào mừng, @User.Identity?.Name!</h1>
                <p class="hero-subtitle">
                    @if (User.IsInRole("Admin"))
                    {
                            <span>Quản trị viên</span>
                    }
                    else if (User.IsInRole("Lecturer"))
                    {
                            <span>Giảng viên</span>
                    }
                    else
                    {
                            <span>Người dùng</span>
                    }
                    - Hệ thống Quản lý Điểm sinh viên
                </p>

                <div class="hero-stats">
                    <div class="stat-item">
                        <div class="stat-number">Đại học Quy Nhơn</div>
                        <div class="stat-label">Đào tạo tín chỉ</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">Quản lý điểm</div>
                        <div class="stat-label">Trực tuyến</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number">Nhập điểm</div>
                        <div class="stat-label">Nhanh chóng</div>
                    </div>
                </div>
            </div>
            <div class="hero-icon">
                <i class="fas fa-university"></i>
            </div>
        </div>
    </div>

    <div class="section">
        <h3 class="section-title">Giới thiệu</h3>
        <div class="about-content">
            <p>Hệ thống quản lý điểm sinh viên hỗ trợ giảng viên nhập điểm, quản lý sinh viên, môn học và lớp học phần. Dữ liệu được cập nhật theo thời gian thực, đảm bảo chính xác và minh bạch.</p>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
            <div class="section">
                <h3 class="section-title">Quản lý hệ thống</h3>
                <div class="quick-actions">
                    <a asp-controller="Students" asp-action="Index" class="action-card text-decoration-none">
                        <div class="action-icon-box bg-primary-soft text-primary">
                            <i class="fas fa-user-graduate fs-4"></i>
                        </div>
                        <div class="action-info">
                            <h4>Sinh viên</h4>
                            <p>Thêm, sửa, xóa, tìm kiếm thông tin sinh viên</p>
                        </div>
                    </a>

                    <a asp-controller="Subjects" asp-action="Index" class="action-card text-decoration-none">
                        <div class="action-icon-box bg-success-soft text-success">
                            <i class="fas fa-book fs-4"></i>
                        </div>
                        <div class="action-info">
                            <h4>Môn học</h4>
                            <p>Quản lý danh sách môn học, tín chỉ, trọng số điểm</p>
                        </div>
                    </a>

                    <a asp-controller="CourseClassManagement" asp-action="Index" class="action-card text-decoration-none">
                        <div class="action-icon-box bg-warning-soft text-warning">
                            <i class="fas fa-layer-group fs-4"></i>
                        </div>
                        <div class="action-info">
                            <h4>Lớp học phần</h4>
                            <p>Phân công giảng viên, tạo lớp học phần</p>
                        </div>
                    </a>

                    <a asp-controller="Lecturers" asp-action="Index" class="action-card text-decoration-none">
                        <div class="action-icon-box bg-info-soft text-info">
                            <i class="fas fa-chalkboard-teacher fs-4"></i>
                        </div>
                        <div class="action-info">
                            <h4>Giảng viên</h4>
                            <p>Tạo tài khoản, phân quyền truy cập</p>
                        </div>
                    </a>
                </div>
            </div>

            <div class="section">
                <h3 class="section-title">Hướng dẫn sử dụng</h3>
                <div class="guide-list">
                    <div class="guide-item">
                        <div class="guide-number">1</div>
                        <div class="guide-content">
                            <h4>Quản lý sinh viên</h4>
                            <p>Truy cập menu "Quản lý sinh viên" để xem danh sách, thêm mới, cập nhật hoặc xóa sinh viên. Có thể tìm kiếm theo mã số, họ tên và lọc theo lớp.</p>
                        </div>
                    </div>
                    <div class="guide-item">
                        <div class="guide-number">2</div>
                        <div class="guide-content">
                            <h4>Quản lý môn học</h4>
                            <p>Thiết lập danh sách môn học, mã môn, tên môn, số tín chỉ. Mỗi môn có trọng số điểm quá trình và cuối kỳ riêng (tổng bằng 100%).</p>
                        </div>
                    </div>
                    <div class="guide-item">
                        <div class="guide-number">3</div>
                        <div class="guide-content">
                            <h4>Quản lý lớp học phần</h4>
                            <p>Tạo lớp học phần, chọn môn học, phân công giảng viên. Mỗi lớp có mã riêng để quản lý.</p>
                        </div>
                    </div>
                    <div class="guide-item">
                        <div class="guide-number">4</div>
                        <div class="guide-content">
                            <h4>Quản lý giảng viên</h4>
                            <p>Tạo tài khoản cho giảng viên, phân quyền truy cập hệ thống.</p>
                        </div>
                    </div>
                </div>
            </div>
    }

    @if (User.IsInRole("Lecturer"))
    {
            <div class="section">
                <h3 class="section-title">Nghiệp vụ giảng dạy</h3>
                <div class="quick-actions">
                    <div class="action-card" style="cursor: default; pointer-events: none;">
                        <div class="action-icon-box bg-danger-soft text-danger">
                            <i class="fas fa-pen-to-square fs-4"></i>
                        </div>
                        <div class="action-info">
                            <h4>Nhập điểm</h4>
                            <p>Chọn lớp học phần, nhập điểm quá trình và cuối kỳ</p>
                        </div>
                    </div>
                    <div class="action-card" style="cursor: default; pointer-events: none;">
                        <div class="action-icon-box bg-primary-soft text-primary">
                            <i class="fas fa-list-check fs-4"></i>
                        </div>
                        <div class="action-info">
                            <h4>Lớp phụ trách</h4>
                            <p>Xem danh sách lớp học phần được phân công giảng dạy</p>
                        </div>
                    </div>
                    <div class="action-card" style="cursor: default; pointer-events: none;">
                        <div class="action-icon-box bg-success-soft text-success">
                            <i class="fas fa-file-excel fs-4"></i>
                        </div>
                        <div class="action-info">
                            <h4>Xuất bảng điểm</h4>
                            <p>Xuất bảng điểm lớp ra file Excel</p>
                        </div>
                    </div>
                    <div class="action-card" style="cursor: default; pointer-events: none;">
                        <div class="action-icon-box bg-info-soft text-info">
                            <i class="fas fa-chart-pie fs-4"></i>
                        </div>
                        <div class="action-info">
                            <h4>Báo cáo thống kê</h4>
                            <p>Xem thống kê đồ thị kết quả học tập</p>
                        </div>
                    </div>
                </div>
            </div>
    }

    <div class="system-info">
        <div class="info-card">
            <i class="fas fa-graduation-cap text-secondary me-1"></i>
            <span>Đại học Quy Nhơn</span>
        </div>
        <div class="info-card">
            <i class="fas fa-laptop-code text-secondary me-1"></i>
            <span>Quản lý điểm sinh viên</span>
        </div>
    </div>
</div>