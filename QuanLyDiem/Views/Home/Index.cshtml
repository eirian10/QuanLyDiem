@{
    ViewData["Title"] = "Trang chủ Hệ thống";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="bg-white p-4 rounded-3 shadow-sm d-flex align-items-center justify-content-between" style="border-left: 5px solid #162a52;">
                <div>
                    <h4 class="fw-bold mb-1" style="color: #162a52;">Chào mừng quay trở lại, @User.Identity.Name!</h4>
                    <p class="text-muted mb-0" style="font-size: 14px;">Hệ thống quản lý điểm và cổng thông tin đào tạo Đại học Quy Nhơn.</p>
                </div>
                <div class="text-end d-none d-sm-block">
                    <span class="badge bg-light text-dark p-2 px-3 rounded-pill fw-medium" style="border: 1px solid #e5e7eb;">
                        <i class="fa-regular fa-calendar me-2 text-warning"></i>Năm học: 2026 - 2027
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-3 shadow-sm h-100" style="background: #ffffff;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 56px; height: 56px; background-color: rgba(22, 42, 82, 0.08);">
                        <i class="fa-solid fa-user-graduate fs-4" style="color: #162a52;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-medium mb-1" style="font-size: 13px;">Tổng số Sinh viên</h6>
                        <h3 class="fw-bold mb-0" style="color: #162a52;">@ViewBag.TotalStudents</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-3 shadow-sm h-100" style="background: #ffffff;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 56px; height: 56px; background-color: rgba(255, 152, 0, 0.1);">
                        <i class="fa-solid fa-chalkboard-teacher fs-4" style="color: #ff9800;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-medium mb-1" style="font-size: 13px;">Tổng số Giảng viên</h6>
                        <h3 class="fw-bold mb-0" style="color: #ff9800;">@ViewBag.TotalTeachers</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-3 shadow-sm h-100" style="background: #ffffff;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 56px; height: 56px; background-color: rgba(40, 167, 69, 0.1);">
                        <i class="fa-solid fa-layer-group fs-4" style="color: #28a745;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-medium mb-1" style="font-size: 13px;">Lớp sinh hoạt</h6>
                        <h3 class="fw-bold mb-0" style="color: #28a745;">@ViewBag.TotalClasses</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 rounded-3 shadow-sm h-100" style="background: #ffffff;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 56px; height: 56px; background-color: rgba(23, 162, 184, 0.1);">
                        <i class="fa-solid fa-university fs-4" style="color: #17a2b8;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted fw-medium mb-1" style="font-size: 13px;">Khoa đào tạo</h6>
                        <h3 class="fw-bold mb-0" style="color: #17a2b8;">@ViewBag.TotalFaculties</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 rounded-3 shadow-sm p-4 bg-white">
                <h5 class="fw-bold mb-3" style="color: #162a52;"><i class="fa-solid fa-bullhorn text-warning me-2"></i>Thông báo mới nhất</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 13px; color: #4b5563;">
                                <th style="width: 15%;">Ngày đăng</th>
                                <th style="width: 65%;">Nội dung thông báo</th>
                                <th style="width: 20%;">Đối tượng</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 14px; color: #1f2937;">
                            <tr>
                                <td class="text-muted">20/05/2026</td>
                                <td class="fw-medium text-dark">Yêu cầu hoàn thành nhập điểm thành phần Học kỳ 2 nhóm lớp CNTTK49</td>
                                <td><span class="badge bg-warning text-dark px-2.5">Giảng viên</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted">18/05/2026</td>
                                <td>Thông báo về việc rà soát điều kiện tốt nghiệp và xét học vụ đợt 1 năm 2026</td>
                                <td><span class="badge bg-info text-white px-2.5">Tất cả</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted">15/05/2026</td>
                                <td>Lịch đăng ký học phần bổ sung cho các lớp học phần mở tăng cường trong hè</td>
                                <td><span class="badge bg-success text-white px-2.5">Sinh viên</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>