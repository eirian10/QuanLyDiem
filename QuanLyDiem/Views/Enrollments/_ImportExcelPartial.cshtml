@model int

<style>
    /* Định dạng tổng thể thẻ Card Import Excel */
    .card-excel {
        border: none !important;
        border-top: 3px solid #162a52 !important;
        background-color: #ffffff;
        border-radius: 8px;
    }

        /* Tiêu đề card header */
        .card-excel .card-header {
            color: #162a52;
            font-weight: 600;
            font-size: 14.5px;
            letter-spacing: 0.3px;
        }

        /* Tinh chỉnh ô chọn file khi focus */
        .card-excel .form-control:focus {
            border-color: #ff9800;
            box-shadow: 0 0 0 0.2rem rgba(255, 152, 0, 0.25);
        }

    /* Thiết kế nút bấm Tải lên mang sắc cam thương hiệu */
    .btn-excel-submit {
        background-color: #ff9800;
        color: #ffffff;
        font-weight: 500;
        font-size: 14px;
        border-radius: 6px;
        transition: all 0.2s ease;
        border: none;
    }

        .btn-excel-submit:hover {
            background-color: #e68900;
            color: #ffffff;
            box-shadow: 0 4px 8px rgba(230, 137, 0, 0.2);
        }

    /* Khung ghi chú nhỏ phía dưới */
    .excel-note {
        font-size: 12px;
        color: #64748b !important;
    }
</style>

<div class="card h-100 shadow-sm card-excel">
    <div class="card-header bg-white py-3">
        <i class="fas fa-file-excel me-1.5" style="color: #162a52;"></i> Import danh sách từ file Excel
    </div>
    <div class="card-body d-flex flex-column justify-content-between">
        <form asp-action="ImportExcel" method="post" enctype="multipart/form-data" class="row g-2 align-items-centerw-100 m-0">
            <input type="hidden" name="courseClassId" value="@Model" />

            <div class="col-8 ps-0">
                <input type="file" name="excelFile" class="form-control" accept=".xlsx, .xls" required />
             

                <div class="col-4 pe-0">
                    <button type="submit" class="btn btn-excel-submit w-100 py-2">
                        <i class="fas fa-cloud-upload-alt me-1"></i>Tải lên
                    </button>
                </div>
        </form>

        <small class="text-muted d-block mt-2 excel-note">
            <i class="fas fa-info-circle me-1 text-secondary"></i>Định dạng: File gồm 1 cột (Mã sinh viên) tại Sheet 1, dữ liệu đọc từ dòng thứ 2.
        </small>
    </div>
</div>