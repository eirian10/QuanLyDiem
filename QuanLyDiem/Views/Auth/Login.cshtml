@model QuanLyDiem.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Hệ thống";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduGrade</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e9f2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(22, 42, 82, 0.08);
            overflow: hidden;
            width: 100%;
            max-width: 900px;
            display: flex;
        }

        .auth-cover {
            background: linear-gradient(180deg, #162a52 0%, #0d1a33 100%);
            padding: 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: #ffffff;
            width: 45%;
        }

        .auth-form-wrap {
            padding: 60px 50px;
            width: 55%;
        }

        .brand-circle {
            width: 90px;
            height: 90px;
            background: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 25px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        }

        .form-control {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 14px;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #ff9800;
            box-shadow: 0 0 0 3px rgba(255, 152, 0, 0.15);
        }

        .input-group .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .input-group-text {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-left: none;
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
            cursor: pointer;
            color: #a0aec0;
            transition: color 0.2s;
        }

        .input-group-text:hover {
            color: #162a52;
        }

        .btn-login {
            background: #ff9800;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            transition: all 0.3s;
        }

        .btn-login:hover {
            background: #e68a00;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 152, 0, 0.3);
        }
    </style>
</head>
<body>
    <div class="container d-flex justify-content-center">
        <div class="auth-card">
            <div class="auth-cover d-none d-md-flex">
                <div class="brand-circle">
                    <i class="fas fa-university fs-1" style="color: #162a52;"></i>
                </div>
                <h3 class="fw-bold mb-2" style="letter-spacing: 1px;">EduGrade</h3>
                <h6 class="mb-4" style="color: #ff9800;">Quy Nhon University</h6>
                <p style="color: #c0cde5; font-size: 14px; line-height: 1.6;">Hệ thống quản lý đào tạo và điểm tín chỉ hiện đại, tối ưu hóa trải nghiệm người dùng.</p>
            </div>

            <div class="auth-form-wrap">
                <div class="mb-4 text-center">
                    <h4 class="fw-bold" style="color: #162a52;">Đăng nhập hệ thống</h4>
                    <p class="text-muted" style="font-size: 14px;">Vui lòng nhập thông tin tài khoản để tiếp tục</p>
                </div>

                @* Nhận thông báo đổi mật khẩu thành công từ Controller *@
                @if (TempData["SuccessMessage"] != null)
                {
                        <div class="alert alert-success text-center mb-3" style="font-size: 13px; border-radius: 10px;">
                            <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                        </div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 13px;"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold" style="color: #3b4d75; font-size: 13px;">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control" placeholder="Nhập tài khoản hoặc email" required autofocus />
                        <span asp-validation-for="Username" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label fw-semibold mb-0" style="color: #3b4d75; font-size: 13px;">Mật khẩu</label>
                            <a asp-controller="Auth" asp-action="ForgotPassword" style="color: #ff9800; font-size: 13px; text-decoration: none;">
                                Quên mật khẩu?
                            </a>
                        </div>
                        <div class="input-group">
                            <input asp-for="Password" type="password" id="txtPassword" class="form-control" placeholder="••••••••" required />
                            <span class="input-group-text" id="togglePassword">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Password" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    <button type="submit" class="btn btn-login mb-4">ĐĂNG NHẬP</button>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('txtPassword');
            const eyeIcon = document.getElementById('eyeIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>