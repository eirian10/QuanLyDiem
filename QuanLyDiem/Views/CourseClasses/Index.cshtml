@model IEnumerable<QuanLyDiem.Models.CourseClass>
@{
    ViewData["Title"] = "Lớp học phần của tôi";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-journal-bookmark"></i> Danh Sách Lớp Học Phần Giảng Dạy</h2>
    <table class="table table-bordered table-striped align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã Lớp Học Phần</th>
                <th>Tên Môn Học</th>
                <th>Số Tín Chỉ</th>
                <th>Học Kỳ / Năm Học</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.ClassCode</strong></td>
                        <td>@item.Subject?.SubjectName</td>
                        <td>@item.Subject?.Credits</td>
                        <td>Học kỳ @item.Semester?.Term (@item.Semester?.AcademicYear)</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.CourseClassId" class="btn btn-primary btn-sm">
                                <i class="bi bi-people-fill"></i>Xem chi tiết
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Bạn chưa được phân công lớp học phần nào trong học kỳ này.</td>
                </tr>
            }
        </tbody>
    </table>
</div>