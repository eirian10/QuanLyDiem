@model int

<div class="card h-100 shadow-sm border-top border-success border-3">
    <div class="card-header bg-white font-weight-bold text-success">
        <i class="bi bi-person-plus"></i> Thêm sinh viên bằng tay
    </div>
    <div class="card-body">
        <form asp-action="AddStudentManual" method="post" class="row g-2 align-items-center">
            <input type="hidden" name="courseClassId" value="@Model" />
            <div class="col-8">
                <input type="text" name="studentCode" class="form-control" placeholder="Nhập đúng Mã sinh viên..." required />
            </div>
            <div class="col-4">
                <button type="submit" class="btn btn-success w-100">Thêm</button>
            </div>
        </form>
    </div>
</div>