@model IEnumerable<QuanLyDiem.Models.Student>
@{
    ViewData["Title"] = "Thành viên lớp học phần";
}

<div class="mb-3">
    <small class="text-muted">
        <a href="/" class="text-decoration-none" style="color: #162a52;">Trang chủ</a> /
        <a href="#" class="text-decoration-none" style="color: #162a52;">Lớp học phần</a> /
        <span class="fw-bold" style="color: #ff9800;">Thành viên lớp</span>
    </small>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0" style="color: #162a52;">
        <i class="fas fa-users-rectangle me-2 opacity-75"></i>Thành viên Lớp học phần
    </h4>
    <div class="d-flex gap-2">
        <a asp-action="AddStudentManual" asp-route-id="@ViewBag.CourseClassId" class="btn text-white" style="background-color: #162a52;">
            <i class="fas fa-keyboard me-2"></i>Nhập tay thủ công
        </a>
        <a asp-action="ImportExcel" asp-route-id="@ViewBag.CourseClassId" class="btn text-white" style="background-color: #2e7d32;">
            <i class="fas fa-file-excel me-2"></i>Import file Excel
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4">@TempData["Error"]</div>
}

<div class="bg-white rounded-3 shadow-sm overflow-hidden">
    <div class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-bold" style="color: #162a52;">Danh sách sinh viên hiện tại</span>
        <span class="badge bg-light text-dark border rounded-pill px-3 py-2">Sĩ số: @(Model?.Count() ?? 0)</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="text-white" style="background-color: #162a52;">
                <tr>
                    <th class="text-center" style="width: 70px;">STT</th>
                    <th>Mã Sinh Viên</th>
                    <th>Họ và Tên lót</th>
                    <th>Tên</th>
                    <th>Email</th>
                    <th class="text-center" style="width: 130px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int stt = 1;
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td class="text-center text-muted">@stt</td>
                            <td class="fw-bold" style="color: #162a52;">@student.StudentCode</td>
                            <td>@student.LastName</td>
                            <td class="fw-semibold">@student.FirstName</td>
                            <td class="text-muted">@student.Email</td>
                            <td class="text-center">
                                <form asp-action="RemoveStudent" method="post" onsubmit="return confirm('Xóa sinh viên này khỏi lớp?');" class="m-0">
                                    <input type="hidden" name="courseClassId" value="@ViewBag.CourseClassId" />
                                    <input type="hidden" name="studentId" value="@student.StudentId" />
                                    <button type="submit" class="btn btn-sm btn-light text-danger custom-logout border-0 fw-medium">
                                        <i class="fas fa-user-minus"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fas fa-folder-open d-block fs-2 mb-2 opacity-50"></i> Lớp học phần này chưa có sinh viên nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>