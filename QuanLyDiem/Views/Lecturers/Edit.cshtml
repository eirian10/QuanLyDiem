@model QuanLyDiem.Models.User

@{
    ViewData["Title"] = "Chỉnh sửa giảng viên";
}

<div class="lecturer-form-page-wrapper">
    <div class="lecturer-form-card">
        <div class="lecturer-form-header">
            <h3>CHỈNH SỬA THÔNG TIN GIẢNG VIÊN</h3>
        </div>

        <div class="lecturer-form-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label">Tên đăng nhập (Mã GV)</label>
                        <input asp-for="Username" class="form-control custom-input" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">Họ và Tên</label>
                        <input asp-for="FullName" class="form-control custom-input" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email liên hệ</label>
                        <input asp-for="Email" type="email" class="form-control custom-input" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FacultyId" class="form-label">Khoa trực thuộc</label>
                        <select asp-for="FacultyId" asp-items="ViewBag.Faculties" class="form-select custom-input">
                        </select>
                        <span asp-validation-for="FacultyId" class="text-danger"></span>
                    </div>
                </div>

                <hr class="form-divider" />

                <div class="form-action-group">
                    <button type="submit" class="btn btn-save-lecturer">
                        Cập nhật thay đổi
                    </button>

                    <a asp-action="Index" class="btn btn-back-lecturer">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .lecturer-form-page-wrapper { background: #ffffff; border-radius: 8px; padding: 24px; min-height: 640px; }
    .lecturer-form-card { background: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08); border: 1px solid #e5e7eb; }
    .lecturer-form-header { background-color: #162f5f; color: #ffffff; padding: 16px 20px; }
    .lecturer-form-header h3 { margin: 0; font-size: 18px; font-weight: 700; text-transform: uppercase; }
    .lecturer-form-body { padding: 28px 24px 22px 24px; }
    .custom-input { height: 42px; border-radius: 6px; border: 1px solid #cfd8e3; font-size: 15px; color: #26364a; }
    .custom-input:focus { border-color: #9bb7df; box-shadow: 0 0 0 0.2rem rgba(22, 47, 95, 0.12); }
    .form-label { font-weight: 500; color: #26364a; margin-bottom: 8px; }
    .form-divider { margin: 26px 0 20px 0; border-top: 1px solid #e5e7eb; }
    .form-action-group { display: flex; gap: 10px; align-items: center; }
    .btn-save-lecturer { background-color: #162f5f; color: #ffffff; border: none; padding: 10px 18px; border-radius: 6px; font-weight: 600; min-width: 160px; }
    .btn-save-lecturer:hover { background-color: #10264d; color: #ffffff; }
    .btn-back-lecturer { background-color: #e5e7eb; color: #374151; border: none; padding: 10px 18px; border-radius: 6px; font-weight: 600; text-decoration: none; min-width: 95px; text-align: center; }
    .btn-back-lecturer:hover { background-color: #d1d5db; color: #111827; }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}