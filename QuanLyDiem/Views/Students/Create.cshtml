@model QuanLyDiem.Models.Student

@{
    ViewData["Title"] = "Thêm Sinh viên mới";
}

<style>
    /* Hệ màu chủ đạo đồng bộ EduGrade - QNU */
    :root {
        --qnu-navy: #162a52;
        --qnu-orange: #ff9800;
        --qnu-dark-blue: #0d1a33;
        --qnu-light-bg: #f8fafc;
    }

    .card-custom {
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

    /* Đổi sang Gradient Xanh Navy sang trọng */
    .bg-qnu-gradient {
        background: linear-gradient(135deg, var(--qnu-navy), var(--qnu-dark-blue));
        color: white;
    }

    .form-label {
        font-weight: 600;
        color: var(--qnu-navy);
        margin-bottom: 0.25rem;
        font-size: 14px;
    }

    /* Đổi hiệu ứng Focus sang màu Cam thương hiệu */
    .form-control:focus, .form-select:focus {
        border-color: var(--qnu-orange);
        box-shadow: 0 0 0 0.25rem rgba(255, 152, 0, 0.2);
    }

    .input-group-text {
        background-color: var(--qnu-light-bg);
        border-color: #dee2e6;
        color: #64748b;
    }

    /* Tinh chỉnh nút Lưu theo sắc cam hành động */
    .btn-save {
        background-color: var(--qnu-orange);
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease;
    }

        .btn-save:hover {
            background-color: #e68900;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(255, 152, 0, 0.25);
        }

    .btn-back {
        color: #64748b;
        text-decoration: none;
        font-weight: 500;
        font-size: 14px;
        transition: 0.2s;
    }

        .btn-back:hover {
            color: var(--qnu-navy);
            text-decoration: underline;
        }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card card-custom shadow-lg">
                <div class="card-header bg-qnu-gradient p-4 text-center border-0">
                    <h3 class="mb-1 fw-bold" style="font-size: 1.4rem; letter-spacing: 0.5px;">
                        <i class="fas fa-user-plus me-2" style="color: var(--qnu-orange);"></i>Thêm Sinh Viên Mới
                    </h3>
                    <small class="text-white-50">Vui lòng điền đầy đủ và chính xác thông tin hồ sơ</small>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-3 text-sm"></div>

                        <div class="mb-3">
                            <label asp-for="StudentCode" class="form-label">Mã số sinh viên (10 chữ số)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                <input asp-for="StudentCode" class="form-control" placeholder="Ví dụ: 4951050001" maxlength="10" autocomplete="off" />
                            </div>
                            <span asp-validation-for="StudentCode" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="LastName" class="form-label">Họ và tên lót</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input asp-for="LastName" class="form-control" placeholder="Ví dụ: Nguyễn Văn" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-4 mt-3 mt-md-0">
                                <label asp-for="FirstName" class="form-label">Tên chính</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                                    <input asp-for="FirstName" class="form-control" placeholder="Ví dụ: An" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label">Giới tính</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-venus-mars"></i></span>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="">-- Chọn giới tính --</option>
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6 mt-3 mt-md-0">
                                <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HomeroomClassId" class="form-label">Lớp sinh hoạt</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-school"></i></span>
                                <select asp-for="HomeroomClassId" class="form-select" asp-items="ViewBag.HomeroomClassId">
                                    <option value="">-- Vui lòng chọn lớp --</option>
                                </select>
                            </div>
                            <span asp-validation-for="HomeroomClassId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">Địa chỉ Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="sinhvien@qnu.edu.vn" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <hr class="my-4" style="border-top: 1px solid #e2e8f0; opacity: 1;">

                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                            <a asp-action="Index" class="btn-back order-2 order-sm-1">
                                <i class="fas fa-arrow-left me-1.5"></i>Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-save px-5 py-2.5 order-1 order-sm-2 w-100 w-sm-auto">
                                <i class="fas fa-check-circle me-1.5"></i>Tạo hồ sơ mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}