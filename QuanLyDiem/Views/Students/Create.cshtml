@model QuanLyDiem.Models.Student

@{
    ViewData["Title"] = "Thêm Sinh viên mới";
}

<style>
    :root {
        --primary-green: #10b981;
        --dark-green: #065f46;
        --light-green: #f0fdf4;
    }

    .card-custom {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .bg-green-gradient {
        background: linear-gradient(135deg, var(--primary-green), var(--dark-green));
        color: white;
    }

    .form-label {
        font-weight: 600;
        color: var(--dark-green);
        margin-bottom: 0.25rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.25);
    }

    .input-group-text {
        background-color: var(--light-green);
        border-color: #dee2e6;
    }

    .btn-save {
        background-color: var(--primary-green);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-save:hover {
            background-color: var(--dark-green);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        }

    .btn-back {
        color: #64748b;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-back:hover {
            color: var(--dark-green);
            text-decoration: underline;
        }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card card-custom shadow-lg animate__animated animate__fadeInUp">
                <div class="card-header bg-green-gradient p-4 text-center border-0">
                    <h3 class="mb-1 fw-bold"><i class="fas fa-user-plus me-2"></i>Thêm Sinh Viên Mới</h3>
                    <small class="opacity-75">Vui lòng điền đầy đủ và chính xác thông tin hồ sơ</small>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-3 text-sm"></div>

                        <div class="mb-3">
                            <label asp-for="StudentCode" class="form-label">Mã số sinh viên (10 chữ số)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-id-card text-success"></i></span>
                                <input asp-for="StudentCode" class="form-control" placeholder="Ví dụ: 4651050001" maxlength="10" />
                            </div>
                            <span asp-validation-for="StudentCode" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="LastName" class="form-label">Họ và tên lót</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user text-success"></i></span>
                                    <input asp-for="LastName" class="form-control" placeholder="Ví dụ: Nguyễn Văn" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-4 mt-3 mt-md-0">
                                <label asp-for="FirstName" class="form-label">Tên chính</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user-tag text-success"></i></span>
                                    <input asp-for="FirstName" class="form-control" placeholder="Ví dụ: An" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label">Giới tính</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-venus-mars text-success"></i></span>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="">-- Chọn giới tính --</option>
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6 mt-3 mt-md-0">
                                <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt text-success"></i></span>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                                </div>
                                <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HomeroomClassId" class="form-label">Lớp sinh hoạt</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-school text-success"></i></span>
                                <select asp-for="HomeroomClassId" class="form-select" asp-items="ViewBag.HomeroomClassId">
                                    <option value="">-- Vui lòng chọn lớp --</option>
                                </select>
                            </div>
                            <span asp-validation-for="HomeroomClassId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">Địa chỉ Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope text-success"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="sinhvien@qnu.edu.vn" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <hr class="my-4 text-muted" style="opacity: 0.15;">

                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                            <a asp-action="Index" class="btn-back order-2 order-sm-1">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-save px-5 py-2 order-1 order-sm-2 w-100 w-sm-auto">
                                <i class="fas fa-check-circle me-1"></i> Tạo hồ sơ mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}