@model IEnumerable<QuanLyDiem.Models.Student>

@{
    ViewData["Title"] = "Danh sách Sinh viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-success font-weight-bold" style="color: #2e7d32 !important;">
            <i class="fas fa-graduation-cap"></i> QUẢN LÝ SINH VIÊN
        </h2>
        <a asp-action="Create" class="btn text-white" style="background-color: #2e7d32; border-color: #2e7d32;">
            <i class="fas fa-plus-circle"></i> Thêm Sinh Viên Mới
        </a>
    </div>

    <div class="card mb-4 border-success" style="border-color: #a5d6a7 !important;">
        <div class="card-body bg-light">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-4 col-sm-12 mb-2">
                    <label class="form-label font-weight-bold text-secondary">Lọc theo lớp sinh hoạt:</label>
                    <select name="homeroomClassId" class="form-control border-success" asp-items="ViewBag.Classes">
                        <option value="">-- Tất cả các lớp --</option>
                    </select>
                </div>
                <div class="col-md-5 col-sm-12 mb-2">
                    <label class="form-label font-weight-bold text-secondary">Từ khóa tìm kiếm:</label>
                    <div class="input-group">
                        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control border-success" placeholder="Nhập mã số, họ lót hoặc tên..." />
                    </div>
                </div>
                <div class="col-md-3 col-sm-12 mb-2 text-md-left text-center mt-md-4">
                    <button type="submit" class="btn text-white px-4 mr-2" style="background-color: #388e3c;">
                        <i class="fas fa-search"></i> Lọc dữ liệu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle">
            <thead class="text-white text-center" style="background-color: #2e7d32;">
                <tr>
                    <th style="width: 12%">Mã SV</th>
                    <th style="width: 25%">Họ và tên lót</th>
                    <th style="width: 13%">Tên</th>
                    <th style="width: 10%">Giới tính</th>
                    <th style="width: 12%">Ngày sinh</th>
                    <th style="width: 13%">Lớp sinh hoạt</th>
                    <th style="width: 15%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold text-center text-dark">@item.StudentCode</td>
                            <td>@item.LastName</td>
                            <td class="font-weight-bold">@item.FirstName</td>
                            <td class="text-center">
                                <span class="badge @(item.Gender == "Nam" ? "bg-info text-dark" : "bg-warning text-dark") px-2 py-1">
                                    @item.Gender
                                </span>
                            </td>
                            <td class="text-center">@item.DateOfBirth.ToString("dd/MM/yyyy")</td>
                            <td class="text-center font-weight-bold text-success">
                                @(item.HomeroomClass != null ? item.HomeroomClass.ClassName : "N/A")
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-outline-success" title="Chỉnh sửa">
                                        Sửa
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-outline-danger" title="Xóa bỏ">
                                        Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Không tìm thấy sinh viên nào phù hợp dữ liệu lọc.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>