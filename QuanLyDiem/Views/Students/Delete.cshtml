@model QuanLyDiem.Models.Student

@{
    ViewData["Title"] = "Xóa thông tin Sinh viên";
}

<style>
    :root {
        --primary-red: #ef4444;
        --dark-red: #b91c1c;
        --light-red: #fef2f2;
    }

    .delete-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header-red {
        background-color: var(--dark-red);
        color: white;
        padding: 20px;
    }

    .info-label {
        font-weight: 600;
        color: #475569;
    }

    .info-value {
        font-weight: 500;
        color: #1e293b;
    }

    .btn-delete {
        background-color: var(--primary-red);
        color: white;
        border: none;
        font-weight: 600;
        padding: 10px 25px;
        transition: 0.3s;
    }

        .btn-delete:hover {
            background-color: var(--dark-red);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

    .btn-back {
        color: #64748b;
        text-decoration: none;
        transition: 0.3s;
        font-weight: 500;
    }

        .btn-back:hover {
            color: #334155;
        }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card delete-card shadow-lg animate__animated animate__fadeIn">
                <div class="card-header-red text-center border-0">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-exclamation-triangle me-2 text-warning"></i>Cảnh Báo Xóa Dữ Liệu</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <i class="fas fa-trash-alt fa-3x text-danger mb-3 opacity-75"></i>
                        <h5 class="text-danger fw-bold">Bạn có chắc chắn muốn xóa sinh viên này?</h5>
                        <p class="text-muted small">Hành động này không thể hoàn tác. Toàn bộ dữ liệu của sinh viên sẽ bị xóa khỏi hệ thống.</p>
                    </div>

                    <div class="bg-light p-4 rounded-3 border mb-4">
                        <div class="row mb-2">
                            <div class="col-5 info-label">Mã số sinh viên:</div>
                            <div class="col-7 info-value text-danger fw-bold">@Model.StudentCode</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 info-label">Họ và tên:</div>
                            <div class="col-7 info-value">@Model.LastName @Model.FirstName</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 info-label">Giới tính:</div>
                            <div class="col-7 info-value">@Model.Gender</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 info-label">Ngày sinh:</div>
                            <div class="col-7 info-value">@Model.DateOfBirth.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-5 info-label">Lớp sinh hoạt:</div>
                            <div class="col-7 info-value fw-bold text-success">
                                @(Model.HomeroomClass.ClassName)
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-5 info-label">Email:</div>
                            <div class="col-7 info-value text-muted">@Model.Email</div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="StudentId" />
                        <hr class="my-4 text-muted" style="opacity: 0.15;">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 order-2 order-sm-1 w-100 w-sm-auto rounded-pill">
                                <i class="fas fa-times me-1"></i> Hủy thao tác
                            </a>
                            <button type="submit" class="btn btn-delete rounded-pill shadow-sm order-1 order-sm-2 w-100 w-sm-auto">
                                <i class="fas fa-trash-alt me-1"></i> Xác nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>