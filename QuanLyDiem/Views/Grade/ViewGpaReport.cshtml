@model List<QuanLyDiem.Models.StudentGpaDTO>

<div class="container-fluid mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light">
            <div class="row align-items-center">
                <div class="mb-3">
                    @if (ViewBag.IsFailedOnly == true)
                    {
                        <a href="@Url.Action("ViewGpaReport", "Grade", new { id = ViewBag.CourseClassId, isFailedOnly = false })" class="btn btn-secondary">
                            <i class="fas fa-list"></i> Xem toàn bộ danh sách
                        </a>

                        <a href="@Url.Action("ExportGpaReportExcel", "Grade", new { id = ViewBag.CourseClassId, isFailedOnly = true })" class="btn btn-success">
                            <i class="fas fa-file-excel"></i> In danh sách học lại (Excel)
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ViewGpaReport", "Grade", new { id = ViewBag.CourseClassId, isFailedOnly = true })" class="btn btn-danger">
                            <i class="fas fa-exclamation-triangle"></i> Xem danh sách học lại (@ViewBag.FailedCount)
                        </a>

                        <a href="@Url.Action("ExportGpaReportExcel", "Grade", new { id = ViewBag.CourseClassId, isFailedOnly = false })" class="btn btn-success">
                            <i class="fas fa-file-excel"></i> Xuất báo cáo GPA (Excel)
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white font-weight-bold d-flex align-items-center justify-content-between">
                    <div>
                        <i class="fas fa-table mr-1"></i>
                        @(ViewBag.IsFailedOnly == true ? "Danh Sách Sinh Viên Học Lại (Điểm F)" : "Danh Sách Điểm Tổng Kết Sinh Viên")
                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered excel-table read-only mb-0">
                        <thead>
                            <tr>
                                <th style="width: 18%">Mã Sinh Viên</th>
                                <th style="width: 37%">Họ và Tên</th>
                                <th style="width: 15%" class="text-center">Điểm Hệ 10</th>
                                <th style="width: 15%" class="text-center">GPA Hệ 4</th>
                                <th style="width: 15%" class="text-center">Điểm Chữ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-secondary">@item.StudentCode</td>
                                        <td class="font-weight-500">@item.FullName</td>
                                        <td class="text-center font-weight-bold text-secondary">
                                            @(item.FinalScore10?.ToString("0.0") ?? "-")
                                        </td>
                                        <td class="text-center font-weight-bold text-primary">
                                            @(item.GpaSystem4?.ToString("0.0") ?? "-")
                                        </td>
                                        <td class="text-center">
                                            <span class="badge p-2 px-3 text-white @(item.LetterGrade == "A" ? "bg-success" : item.LetterGrade == "F" ? "bg-danger" : "bg-primary")" style="font-size: 0.9rem; min-width: 45px; display: inline-block;">
                                                @item.LetterGrade
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted p-4">Không có dữ liệu sinh viên trong lớp học phần này.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white text-center font-weight-bold">
                    <i class="fas fa-chart-pie mr-1"></i> Tỷ Lệ Phần Trăm Điểm Hệ Chữ
                </div>
                <div class="card-body d-flex justify-content-center align-items-center" style="min-height: 290px;">
                    <canvas id="letterPieChart" style="max-height: 260px; max-width: 260px;"></canvas>
                </div>
            </div>

            <div class="card border-danger shadow-sm">
                <div class="card-body bg-light text-center">
                    <h5 class="card-title text-danger font-weight-bold mb-3">
                        <i class="fas fa-exclamation-triangle mr-1"></i> THÔNG TIN HỌC LẠI
                    </h5>
                    <p class="card-text mb-2" style="font-size: 1.1rem; color: #495057;">
                        Số sinh viên bị điểm <strong class="text-danger">F</strong>:
                        <strong class="text-danger font-weight-bold px-1" style="font-size: 1.4rem;">
                            @(ViewBag.FailedCount ?? 0)
                        </strong> sinh viên.
                    </p>
                    @if (ViewBag.FailedCount > 0)
                    {
                        <small class="text-muted d-block mt-3" style="line-height: 1.4;">
                            * Những sinh viên thuộc diện điểm F bắt buộc phải đăng ký học lại học phần này ở các kỳ sau để hoàn thành chương trình.
                        </small>
                    }
                    else
                    {
                        <small class="text-success font-weight-bold d-block mt-3">
                            <i class="fas fa-check-circle mr-1"></i> Tuyệt vời! Lớp học phần này không có sinh viên nào bị điểm F (phải học lại).
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/gpa-chart.js" asp-append-version="true"></script>

    <script>
        // Lấy dữ liệu dạng mảng JSON thô từ Controller qua ViewBag
        const labelsLetter = @Html.Raw(Json.Serialize(ViewBag.LetterLabels));
        const dataLetter = @Html.Raw(Json.Serialize(ViewBag.LetterData));

        // Khởi động chạy hàm vẽ biểu đồ ngay khi cấu hình cây thư mục DOM sẵn sàng
        document.addEventListener("DOMContentLoaded", function () {
            if (labelsLetter && dataLetter && dataLetter.length > 0) {
                initGpaPieChart(labelsLetter, dataLetter);
            }
        });
    </script>
}