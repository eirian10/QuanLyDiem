@model List<QuanLyDiem.Models.StudentGpaDTO>

@{
    ViewData["Title"] = "Báo cáo điểm GPA";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Grade.css" asp-append-version="true" />

    <style>
        .custom-card-header {
            background-color: #162a52 !important;
            color: #ffffff !important;
            font-weight: 600 !important;
        }
    </style>
}

<div class="container-fluid px-1 mt-3">

    @* --- THANH ĐIỀU HƯỚNG QUAY LẠI CHUẨN ---
       Giúp giảng viên dễ dàng click quay ngược về trang danh sách lớp học phần gốc,
       đồng thời hiển thị mã lớp hiện tại trên thanh điều hướng để nhận biết vị trí trang.
    *@
    <nav aria-label="breadcrumb" class="custom-breadcrumb mb-3">
        <ol class="breadcrumb" style="background: transparent; padding: 0;">
            <li class="breadcrumb-item">
                <a asp-controller="Enrollments" asp-action="Index">
                    <i class="fas fa-arrow-left me-1"></i>Danh sách lớp
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("EnterScores", "Grade", new { id = ViewBag.CourseClassId })">
                    Nhập điểm
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Báo cáo GPA</li>
        </ol>
    </nav>

    @* --- KHUNG THÔNG TIN CHUNG CỦA LỚP HỌC PHẦN ---
       Hiển thị trực quan Mã lớp học phần và Tên môn học hiện tại đang thực hiện thao tác dữ liệu,
       được đồng bộ màu sắc thương hiệu (Navy - Cam) giúp giao diện rõ ràng, chuyên nghiệp.
    *@
    <div class="card info-card p-4 mb-4 shadow-sm">
        <h4 class="mb-2">Lớp Học Phần: <span>@ViewBag.ClassCode</span></h4>
        <p class="mb-0 text-secondary">
            <i class="fas fa-book me-1.5" style="color: #ff9800;"></i>Môn học: <strong style="color: #1c2536;">@ViewBag.SubjectName</strong>
        </p>
    </div>

    <div class="d-flex justify-content-start align-items-center mb-3" style="gap: 8px;">
        @* Sử dụng biến ViewBag.IsFailedOnly kiểm tra trạng thái bộ lọc:
            - Nếu đang xem danh sách HỌC LẠI: Hiển thị nút quay về và nút in danh sách trượt.
            - Nếu đang xem danh sách TOÀN BỘ: Hiển thị nút lọc danh sách trượt và nút xuất báo cáo tổng.
        *@
        @if (ViewBag.IsFailedOnly == true)
        {
            <a href="@Url.Action("ViewGpaReport", "Grade", new { id = ViewBag.CourseClassId, isFailedOnly = false })" class="btn text-white shadow-sm" style="background-color: #162a52; font-size: 13px; font-weight: 500; border-radius: 6px; padding: 6px 14px;">
                <i class="fas fa-list me-1"></i> Xem toàn bộ danh sách
            </a>

            <a href="@Url.Action("ExportGpaReportExcel", "Grade", new { id = ViewBag.CourseClassId, isFailedOnly = true })" class="btn text-white shadow-sm" style="background-color: #28a745; font-size: 13px; font-weight: 500; border-radius: 6px; padding: 6px 14px; border: none;">
                <i class="fas fa-file-excel me-1"></i> In danh sách học lại (Excel)
            </a>
        }
        else
        {
            <a href="@Url.Action("ViewGpaReport", "Grade", new { id = ViewBag.CourseClassId, isFailedOnly = true })" class="btn text-white shadow-sm" style="background-color: #dc3545; font-size: 13px; font-weight: 500; border-radius: 6px; padding: 6px 14px; border: none;">
                <i class="fas fa-exclamation-triangle me-1"></i> Xem danh sách học lại (@ViewBag.FailedCount)
            </a>

            <a href="@Url.Action("ExportGpaReportExcel", "Grade", new { id = ViewBag.CourseClassId, isFailedOnly = false })" class="btn text-white shadow-sm" style="background-color: #28a745; font-size: 13px; font-weight: 500; border-radius: 6px; padding: 6px 14px; border: none;">
                <i class="fas fa-file-excel me-1"></i> Xuất báo cáo GPA (Excel)
            </a>
        }
    </div>

    <div class="row">

        <div class="col-md-8">
            <div class="card shadow-sm border-0" style="border-radius: 10px; overflow: hidden;">
                <div class="card-header custom-card-header py-3">
                    <i class="fas fa-table me-1"></i>
                    @(ViewBag.IsFailedOnly == true ? "Danh Sách Sinh Viên Học Lại (Điểm F)" : "Danh Sách Điểm Tổng Kết Sinh Viên")
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        @* Áp dụng class .read-only để kích hoạt padding hợp lý cho bảng tĩnh theo mô tả CSS thiết kế *@
                        <table class="table table-bordered excel-table read-only m-0">
                            <thead>
                                <tr>
                                    <th style="width: 20%; text-align: left !important;">Mã Sinh Viên</th>
                                    <th style="width: 35%; text-align: left !important;">Họ và Tên</th>
                                    <th style="width: 15%" class="text-center">Điểm Hệ 10</th>
                                    <th style="width: 15%" class="text-center">GPA Hệ 4</th>
                                    <th style="width: 15%" class="text-center">Điểm Chữ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><strong style="color: #162a52;">@item.StudentCode</strong></td>
                                            <td class="fw-medium">@item.FullName</td>

                                            <td class="text-center fw-bold text-secondary">
                                                @(item.FinalScore10?.ToString("0.0") ?? "-")
                                            </td>

                                            <td class="text-center fw-bold text-primary">
                                                @(item.GpaSystem4?.ToString("0.0") ?? "-")
                                            </td>

                                            <td class="text-center">
                                                @{
                                                    string letter = item.LetterGrade;
                                                    // Thuật toán gán màu nhanh dựa theo ký tự đầu của điểm chữ:
                                                    // - Bắt đầu bằng 'A' (A+, A) -> màu xanh lá (bg-success)
                                                    // - Các nhóm Khá/Trung bình khá (B+, B, C) -> màu xanh dương (bg-primary)
                                                    // - Điểm Trung bình (D) -> màu vàng, chữ đen (bg-warning text-dark)
                                                    // - Còn lại (Điểm F) -> màu đỏ (bg-danger)
                                                    string badgeClass = letter.StartsWith("A") ? "bg-success" :
                                                    (letter == "B+" || letter == "B" || letter == "C") ? "bg-primary" :
                                                    letter == "D" ? "bg-warning text-dark" : "bg-danger";
                                                }
                                                <span class="badge p-2 px-3 text-white @badgeClass" style="font-size: 0.85rem; min-width: 45px; display: inline-block; border-radius: 4px;">
                                                    @letter
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted p-4">Không có dữ liệu sinh viên trong lớp học phần này.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">

            <div class="card shadow-sm mb-4 border-0" style="border-radius: 10px; overflow: hidden;">
                <div class="card-header bg-dark text-white text-center py-3" style="font-size: 14px; font-weight: 600;">
                    <i class="fas fa-chart-pie me-1"></i> Tỷ Lệ Phần Trăm Điểm Hệ Chữ
                </div>
                <div class="card-body d-flex justify-content-center align-items-center bg-white" style="min-height: 290px;">
                    <canvas id="letterPieChart" style="max-height: 250px; max-width: 250px;"></canvas>
                </div>
            </div>

            <div class="card border-danger shadow-sm border-0" style="border-radius: 10px; overflow: hidden; border-left: 5px solid #dc3545 !important;">
                <div class="card-body bg-light text-center p-4">
                    <h5 class="card-title text-danger fw-bold mb-3" style="font-size: 15px;">
                        <i class="fas fa-exclamation-triangle me-1"></i> THÔNG TIN HỌC LẠI
                    </h5>
                    <p class="card-text mb-2" style="font-size: 1.05rem; color: #495057;">
                        Số sinh viên bị điểm <strong class="text-danger">F</strong>:
                        <strong class="text-danger fw-bold px-1" style="font-size: 1.4rem;">
                            @(ViewBag.FailedCount ?? 0)
                        </strong> sinh viên.
                    </p>

                    @* Hiển thị lời nhắc hoặc lời khen động tùy theo số lượng sinh viên trượt môn *@
                    @if (ViewBag.FailedCount > 0)
                    {
                        <small class="text-muted d-block mt-3" style="line-height: 1.5; font-size: 12px;">
                            * Những sinh viên thuộc diện điểm F bắt buộc phải đăng ký học lại học phần này ở các kỳ sau để hoàn thành chương trình.
                        </small>
                    }
                    else
                    {
                        <small class="text-success fw-bold d-block mt-3" style="font-size: 13px;">
                            <i class="fas fa-check-circle me-1"></i> Tuyệt vời! Lớp học phần này không có sinh viên nào bị điểm F (phải học lại).
                        </small>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/gpa-chart.js" asp-append-version="true"></script>

    <script>
        // Đồng bộ dữ liệu mảng từ C# sang mảng đối tượng JavaScript qua ViewBag
        // labelsLetter sẽ chứa danh sách các khóa: ["A+", "A", "B+", "B", "C", "D", "F"]
        // dataLetter sẽ chứa danh sách số lượng sinh viên tương ứng: [2, 5, 12, 8, 4, 1, 0]
        const labelsLetter = @Html.Raw(Json.Serialize(ViewBag.LetterLabels));
        const dataLetter = @Html.Raw(Json.Serialize(ViewBag.LetterData));

        // Chờ toàn bộ cấu trúc cây DOM HTML tải xong rồi mới khởi tạo vẽ biểu đồ
        document.addEventListener("DOMContentLoaded", function () {
            if (labelsLetter && dataLetter && dataLetter.length > 0) {
                // Gọi hàm khởi tạo biểu đồ hình tròn được định nghĩa trong file gpa-chart.js
                initGpaPieChart(labelsLetter, dataLetter);
            }
        });
    </script>
}